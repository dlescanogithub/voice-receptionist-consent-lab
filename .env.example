# Copy to .env locally if you want. This process does not read .env.
# Empty means "not set". Never commit a real .env.

# The live probe refuses unless this is exactly 1. Pytest and CI leave it unset.
LIVE_ENABLED=0
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_BRANCH_ID=

LOG_LEVEL=INFO
CONSENT_LAB_SEED=42
CONSENT_LAB_MAX_ATTEMPTS=3
CONSENT_LAB_BACKOFF_BASE_S=0.5
CONSENT_LAB_BACKOFF_CAP_S=8
CONSENT_LAB_EVIDENCE_ROOT=evidence/ab
CONSENT_LAB_SAMPLE_RATE=16000
CONSENT_LAB_MIN_SAMPLES=1600
CONSENT_LAB_POLL_TIMEOUT_S=0.5
CONSENT_LAB_QUIET_AFTER_S=1.0
CONSENT_LAB_OVERALL_TIMEOUT_S=20
CONSENT_LAB_PLAYBACK_PAD_S=0.4
CONSENT_LAB_FEED_INTERVAL_S=0.1
CONSENT_LAB_SILENCE_BYTES=3200
CONSENT_LAB_SIGNED_URL_BASE=https://api.elevenlabs.io/v1/convai/conversation/get-signed-url
